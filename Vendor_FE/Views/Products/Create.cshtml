@model Vendor_FE.Models.ProductCreateRequestDTO
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="container-fluid py-4 max-w-1000">
    <div class="d-flex align-items-center mb-4">
        <a href="/Products/Index" class="btn btn-light rounded-circle shadow-sm me-3 d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-arrow-left text-dark"></i>
        </a>
        <h2 class="fw-bold mb-0 text-primary">
            <i class="fa-solid fa-plus-circle me-2"></i>Thêm Sản Phẩm Mới
        </h2>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }
            <div id="validation-errors" class="alert alert-danger d-none mb-4"></div>
            <form id="productForm" method="post" action="/Products/Create" enctype="multipart/form-data">
                <div class="row">
                    <!-- Right Column: Image Upload (Displayed on mobile too) -->
                    <div class="col-12 col-md-4 mb-4 mb-md-0 order-md-2">
                        <label class="form-label fw-bold"><i class="fa-solid fa-camera me-2"></i>Ảnh Sản Phẩm</label>
                        <div class="card border-2 border-dashed rounded-4 bg-light text-center" style="height: 250px; cursor: pointer;" id="imageUploadArea">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center" id="uploadPlaceholder">
                                <i class="fa-solid fa-cloud-arrow-up fa-3x text-primary mb-3"></i>
                                <p class="text-muted mb-0">Kéo thả ảnh vào đây<br>hoặc click để chọn</p>
                            </div>
                            <img id="imagePreview" src="#" class="d-none w-100 h-100 object-fit-cover rounded-4" alt="Preview">
                        </div>
                        <input type="file" id="productImage" name="Image" class="d-none" accept="image/*">
                        <div class="text-center mt-3 d-none" id="removeImageBtn">
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"><i class="fa-solid fa-trash me-1"></i>Xoá Ảnh</button>
                        </div>
                    </div>

                    <!-- Left Column: Product Details -->
                    <div class="col-12 col-md-8 order-md-1 pe-md-5">
                        <div class="mb-4">
                            <label for="productName" class="form-label fw-bold"><i class="fa-solid fa-box me-2"></i>Tên Sản Phẩm <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg rounded-3" id="productName" name="ProductName" placeholder="Ví dụ: Áo Sơ Mi Nam Cao Cấp" required>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label for="categoryId" class="form-label fw-bold"><i class="fa-solid fa-tags me-2"></i>Danh Mục <span class="text-danger">*</span></label>
                                <select class="form-select form-select-lg rounded-3" id="categoryId" name="CategoryId" required>
                                    <option value="">Chọn danh mục</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var cat in (Dictionary<int, string>)ViewBag.Categories)
                                        {
                                            <option value="@cat.Key" selected="@(Model?.CategoryId == cat.Key ? "selected" : null)">@cat.Value</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="unit" class="form-label fw-bold"><i class="fa-solid fa-scale-balanced me-2"></i>Đơn Vị Tính <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-lg rounded-3" id="unit" name="Unit" placeholder="Ví dụ: Cái, Kg, Hộp..." required>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label for="price" class="form-label fw-bold"><i class="fa-solid fa-money-bill-wave me-2"></i>Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <input type="number" class="form-control rounded-start-3" id="price" name="Price" placeholder="0" min="0" required>
                                <span class="input-group-text rounded-end-3 bg-light">VNĐ</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top">
                            <a href="/Products/Index" class="btn btn-light btn-lg px-4 rounded-pill fw-bold">Hủy</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold shadow hover-lift"><i class="fa-solid fa-floppy-disk me-2"></i>Lưu Sản Phẩm</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; border-color: #adb5bd !important; }
    .object-fit-cover { object-fit: cover !important; }
    .max-w-1000 { max-width: 1000px; margin: 0 auto; }
    .hover-lift { transition: transform 0.2s; }
    .hover-lift:hover { transform: translateY(-2px); }
</style>

<!-- Đoạn script nhỏ gọn phục vụ Preview Ảnh UI -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const uploadArea = document.getElementById('imageUploadArea');
        const fileInput = document.getElementById('productImage');
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');
        const removeBtn = document.getElementById('removeImageBtn');
        const form = document.getElementById('productForm');
        const errorContainer = document.getElementById('validation-errors');

        uploadArea.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', function (e) {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    preview.src = event.target.result;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                    removeBtn.classList.remove('d-none');
                    uploadArea.classList.remove('bg-light');
                }
                reader.readAsDataURL(file);
            }
        });

        removeBtn.addEventListener('click', function (e) {
            fileInput.value = '';
            preview.src = '#';
            preview.classList.add('d-none');
            placeholder.classList.remove('d-none');
            removeBtn.classList.add('d-none');
            uploadArea.classList.add('bg-light');
        });

        function countWords(str) {
            return str.trim().split(/\s+/).filter(word => word.length > 0).length;
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            
            const nameField = document.getElementById('productName').value.trim();
            const unitField = document.getElementById('unit').value.trim();
            const priceField = document.getElementById('price').value.trim();
            const categoryField = document.getElementById('categoryId').value;
            
            errorContainer.innerHTML = '';
            let errors = [];

            // 1. Kiểm tra rỗng
            if (!nameField) errors.push("Tên sản phẩm không được để trống.");
            if (!unitField) errors.push("Đơn vị tính không được để trống.");
            if (!priceField || isNaN(priceField) || Number(priceField) < 0) errors.push("Giá bán không hợp lệ (phải là số lớn hơn hoặc bằng 0).");
            if (!categoryField) errors.push("Vui lòng chọn danh mục sản phẩm.");

            // 2. Kiểm tra ký tự đặc biệt
            const specialCharPattern = /[!@@#$%^&*()_+=\[\]{};'"\\|<>\/?]+/;
            if (specialCharPattern.test(nameField)) {
                errors.push("Tên sản phẩm không được chứa ký tự đặc biệt.");
            }
            if (specialCharPattern.test(unitField)) {
                errors.push("Đơn vị tính không được chứa ký tự đặc biệt.");
            }

            // 3. Kiểm tra số lượng từ
            if (countWords(nameField) > 20) {
                errors.push(`Tên sản phẩm quá dài (${countWords(nameField)}/20 từ).`);
            }
            if (countWords(unitField) > 5) {
                errors.push(`Đơn vị tính quá dài (${countWords(unitField)}/5 từ).`);
            }

            if (errors.length > 0) {
                errorContainer.innerHTML = "<strong>Vui lòng sửa các lỗi sau:</strong><ul>" + errors.map(err => `<li>${err}</li>`).join('') + "</ul>";
                errorContainer.classList.remove('d-none');
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            } else {
                errorContainer.classList.add('d-none');
            }

            // 4. Xác nhận lưu
            confirmAction(null, form, 'Thêm sản phẩm', 'Bạn có chắc chắn muốn thêm sản phẩm này không?', 'question', 'btn-primary');
        });
    });
</script>
