@model Vendor_FE.Models.VendorProfileResponseDTO
@{
    ViewData["Title"] = "Hồ Sơ Cửa Hàng";
}

<div class="container-fluid py-4">
    <div class="max-w-1000 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0 text-primary">
                <i class="fa-solid fa-store me-2"></i>Hồ Sơ Cửa Hàng
            </h2>
        </div>

        <div class="card shadow border-0 rounded-4 overflow-hidden mb-5">
            <!-- Cover Image Section -->
            <div class="position-relative bg-light cover-wrapper">
                <img id="coverPreview" src="@(Model?.CoverImageUrl ?? "https://res.cloudinary.com/demo/image/upload/v1312461204/sample.jpg")" class="w-100 h-100 object-fit-cover" alt="Cover Image">
                
                <!-- Nút đổi ảnh cover nổi trên hình -->
                <button type="button" class="btn btn-light position-absolute cover-change-btn rounded-pill shadow fw-bold" onclick="document.getElementById('coverInput').click()">
                    <i class="fa-solid fa-camera me-2"></i>Thay đổi ảnh bìa
                </button>
                <input type="file" id="coverInput" name="NewCoverImage" class="d-none" accept="image/*">
            </div>

            <!-- Profile Detail Section -->
            <div class="card-body p-4 p-md-5 position-relative">
                <!-- Layout: title/metadata on left, actions on right -->
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3 profile-top">
                    <div class="d-flex flex-column">
                        <h3 class="mb-1 fw-bold profile-store">@Model?.BusinessName</h3>
                        <div class="text-muted small">
                            Owner: <span class="fw-medium">@Model?.OwnerName ?? "N/A"</span>
                            <br />
                            Vendor ID: <span class="fw-medium">@Model?.VendorId</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end gap-2 action-stack">
                        <a href="/VendorProfiles/Edit/@Model?.VendorId" class="btn btn-outline-primary rounded-pill px-4">Edit Profile</a>
                        <a href="/Account/RequestOtpEmail" class="btn btn-outline-secondary rounded-pill px-4">Change Password</a>
                        <a href="/Products/Index" class="btn btn-primary rounded-pill px-4">Manage Products</a>
                    </div>
                </div>

                <hr class="my-3" />

                <div>
                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(Model?.Description) ? "No description provided." : Model.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .max-w-1000 { max-width: 1000px; margin: 0 auto; }

    /* cover */
    .object-fit-cover { object-fit: cover !important; }
    .cover-wrapper { height: 160px; overflow: hidden; position: relative; border-bottom-left-radius: .5rem; border-bottom-right-radius: .5rem; }
    @@media (min-width: 992px) {
        .cover-wrapper { height: 180px; }
    }

    /* store title */
    .profile-store { font-size: 1.5rem; margin-bottom: 0; }

    /* actions */
    .action-stack a { min-width: 180px; }
    @@media (max-width: 767.98px) {
        .action-stack { align-items: flex-start; }
        .action-stack a { min-width: 140px; }
        .profile-store { font-size: 1.2rem; }
        .cover-wrapper { height: 140px; }
    }

    /* small visual tweaks */
    .profile-top { margin-top: -28px; } /* pull content up slightly to sit under cover like screenshot */
    .card-body { padding-top: 36px !important; } /* give room for pulled content */

    .cover-change-btn { bottom: 1rem; right: 1rem; }
    .hover-lift { transition: transform 0.18s, box-shadow 0.18s; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.12)!important; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fileInput = document.getElementById('coverInput');
        const preview = document.getElementById('coverPreview');
        const form = document.getElementById('profileForm');
        const errorContainer = document.getElementById('validation-errors');

        if (fileInput && preview) {
            fileInput.addEventListener('change', function (e) {
                const file = this.files && this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        preview.src = event.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    });
</script>
