<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Market Vendor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        /* small header tweaks */
        .topbar { height: 73px; align-items: center; }
        .page-title { font-weight: 600; margin: 0 0 0 12px; }
        .nav-actions a { margin-left: 12px; }
        /* keep content scrollable and avoid full-height clipping */
        #page-content-wrapper { min-height: 100vh; }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex w-100" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark text-white shadow-sm" id="sidebar-wrapper">
            <div class="sidebar-heading d-flex align-items-center justify-content-center fs-5 fw-bold text-uppercase border-bottom border-secondary m-0" style="height: 73px;">
                <i class="fa-solid fa-store me-2 text-warning"></i>Smart Market
            </div>
            <div class="list-group list-group-flush mt-2">
                <a href="/Home/Index" class="list-group-item list-group-item-action bg-transparent text-white fw-medium py-3 px-4 d-flex align-items-center">
                    <i class="fa-solid fa-gauge-high me-3 fs-5" style="width: 24px; text-align: center;"></i> Bảng điều khiển
                </a>
                <a href="/Products/Index" class="list-group-item list-group-item-action bg-transparent text-white fw-medium py-3 px-4 d-flex align-items-center">
                    <i class="fa-solid fa-box me-3 fs-5" style="width: 24px; text-align: center;"></i> Quản lý Sản phẩm
                </a>
                <a href="/Invoice/Index" class="list-group-item list-group-item-action bg-transparent text-white fw-medium py-3 px-4 d-flex align-items-center">
                    <i class="fa-solid fa-file-invoice-dollar me-3 fs-5" style="width: 24px; text-align: center;"></i> Thanh toán Phụ phí
                </a>
                <a href="/Support/Index" class="list-group-item list-group-item-action bg-transparent text-white fw-medium py-3 px-4 d-flex align-items-center">
                    <i class="fa-solid fa-triangle-exclamation me-3 fs-5" style="width: 24px; text-align: center;"></i> Báo cáo Sự cố
                </a>
                <a href="/VendorProfiles/Index" class="list-group-item list-group-item-action bg-transparent text-white fw-medium py-3 px-4 d-flex align-items-center">
                    <i class="fa-solid fa-shop me-3 fs-5" style="width: 24px; text-align: center;"></i> Thông tin Gian hàng
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column" style="overflow-y: auto; overflow-x: hidden;">
            <!-- Top Header -->
            <nav class="navbar navbar-expand-lg navbar-white bg-white border-bottom shadow-sm px-4 topbar" role="navigation">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center me-2" id="menu-toggle" style="width: 40px; height: 40px; padding: 0;">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="page-title mb-0">@ViewData["Title"]</h5>
                </div>

                <div class="ms-auto d-flex align-items-center nav-actions">
                    @if (Context.Request.Cookies["VendorAuth"] != null)
                    {
                        <a class="btn btn-outline-secondary me-2" asp-controller="Vendor" asp-action="Profile" title="Profile">
                            <i class="fa-solid fa-user"></i> Hồ sơ
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link text-decoration-none">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-primary ms-2" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </nav>

            <div class="container py-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Vendor_FE - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById("menu-toggle")?.addEventListener("click", function (e) {
            e.preventDefault();
            document.getElementById("wrapper")?.classList.toggle("toggled");
        });

        // Hàm hỗ trợ confirm chung toàn hệ thống
        function confirmAction(e, form, title, text, icon = 'warning', confirmBtnClass = 'btn-primary') {
            if (e) e.preventDefault();
            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                showCancelButton: true,
                customClass: {
                    confirmButton: `btn ${confirmBtnClass} px-4 me-2`,
                    cancelButton: 'btn btn-light px-4'
                },
                buttonsStyling: false,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    if (form) form.submit();
                }
            });
            return false;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
