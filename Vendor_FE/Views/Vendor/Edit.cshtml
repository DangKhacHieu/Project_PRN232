@model Vendor_FE.Models.VendorEditViewModel

@{
    ViewData["Title"] = "Edit Vendor Profile";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width:900px;">
        <div class="card-body">
            <h4 class="mb-3">Edit Profile</h4>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-warning">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Edit" asp-controller="Vendor" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VendorId" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Business name</label>
                        <input asp-for="BusinessName" class="form-control" />
                        <span asp-validation-for="BusinessName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Owner name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Current cover</label>
                        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@(Model.CoverImageUrl)" style="max-width:100%; height:160px; object-fit:cover;" alt="Current cover" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-2 text-muted">No current image</div>
                        }
                        <label class="form-label">Upload new cover</label>
                        <input asp-for="AvatarFile" type="file" accept="image/*" class="form-control" id="avatarInput" />
                        <small class="text-muted">Max size depends on backend configuration.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Preview</label>
                        <div id="avatarPreview" style="width:100%; height:160px; background:#f6f6f6; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                            {
                                <img src="@(Model.CoverImageUrl)" id="previewImg" style="width:100%; height:160px; object-fit:cover;" alt="preview" />
                            }
                            else
                            {
                                <img id="previewImg" style="display:none; width:100%; height:160px; object-fit:cover;" alt="preview" />
                            }
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Profile" asp-controller="Vendor" asp-route-id="@Model.VendorId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('avatarInput')?.addEventListener('change', function (evt) {
            var input = evt.target;
            var file = input.files && input.files[0];
            var previewImg = document.getElementById('previewImg');
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewImg.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                previewImg.src = '';
                previewImg.style.display = 'none';
            }
        });
    </script>
}
