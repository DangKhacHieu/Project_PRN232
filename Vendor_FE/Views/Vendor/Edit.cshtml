@model Vendor_FE.Models.VendorEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width:900px;">
        <div class="card-body">
            <h4 class="mb-3">Chỉnh sửa hồ sơ</h4>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-warning">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Edit" asp-controller="Vendor" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VendorId" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Tên cửa hàng</label>
                        <input asp-for="BusinessName" class="form-control" />
                        <span asp-validation-for="BusinessName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tên chủ</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>


                    <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Profile" asp-controller="Vendor" asp-route-id="@Model.VendorId" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                document.getElementById('avatarInput')?.addEventListener('change', function (evt) {
                    var input = evt.target;
                    var file = input.files && input.files[0];
        var previewImg = document.getElementById('previewImg');
                    if (file) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                            previewImg.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else {
                        previewImg.src = '';
                        previewImg.style.display = 'none';
                    }
                });
    </script>
}
