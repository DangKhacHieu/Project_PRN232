@model Vendor_FE.Models.VendorProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-center">
        <div class="card profile-card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="profile-cover"></div>

            <div class="card-body p-4 position-relative">
                <div class="profile-avatar">
                    @if (!string.IsNullOrWhiteSpace(Model?.BusinessName))
                    {
                        @Model.BusinessName.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        <i class="fa-solid fa-store"></i>
                    }
                </div>

                <div class="d-flex align-items-start gap-4 flex-wrap">
                    <div class="profile-info">
                        <h2 class="mb-1 fw-bold profile-title">@(Model?.BusinessName ?? "Chưa có tên cửa hàng")</h2>
                        <p class="text-muted mb-1 small meta-line">Chủ cửa hàng: @(Model?.FullName ?? "N/A")</p>
                        <p class="text-muted mb-1 small meta-line">Mã nhà bán: @(Model?.VendorId?.ToString() ?? "—")</p>

                        <div class="mt-2 description-block">
                            <h5 class="fw-bold mb-2 desc-title">Mô tả</h5>
                            <p class="text-muted mb-0 desc-body">
                                @(string.IsNullOrWhiteSpace(Model?.Description) ? "Chưa có mô tả." : Model.Description)
                            </p>
                        </div>
                    </div>  

                    <div class="profile-actions ms-auto d-flex flex-column gap-2">
                        <a href="/Vendor/Edit/@Model?.VendorId" class="btn btn-outline-primary rounded-pill px-4">Chỉnh sửa hồ sơ</a>
                        <a href="/Account/RequestOtpEmail" class="btn btn-outline-secondary rounded-pill px-4">Đổi mật khẩu</a>
                        <a href="/Products/Index" class="btn btn-primary rounded-pill px-4">Quản lý sản phẩm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-card {
        max-width: 920px;
        width: 100%;
    }

    .profile-cover {
        height: 140px;
        background: linear-gradient(135deg, #0d6efd, #6ea8fe);
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
    }

    .card-body {
        padding-top: 56px !important; /* room for avatar */
    }

    .profile-avatar {
        position: absolute;
        margin-top: 22px;
        left: 18px;
        top: 17px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #6c757d;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 44px;
        font-weight: 700;
        border: 6px solid #fff;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }

    .profile-info {
        min-width: 280px;
        max-width: 620px;
    }

    /* Title spacing: increase letter-spacing and spacing under */
    .profile-title {
        margin-left: 60px;
        letter-spacing: 0.6px;      /* slight wider letters */
        word-spacing: 2px;         /* small extra space between words */
        line-height: 1.05;
        margin-bottom: .5rem;
    }

    /* Meta lines (owner, vendor id) - widen and increase line-height for readability */
    .meta-line {
        letter-spacing: 0.25px;
        line-height: 1.6;          /* more vertical spacing between meta lines */
        margin-bottom: .35rem;
        color: #6b7280;
    }

    /* Description heading and body spacing */
    .desc-title {
        letter-spacing: 0.4px;
        margin-top: .5rem;
    }

    .desc-body {
        letter-spacing: 0.2px;
        line-height: 1.7;          /* looser line-height for description */
        margin-bottom: 0;
        color: #6b7280;
    }

    .profile-actions a {
        min-width: 180px;
    }

    .description-block { margin-top: 12px; }

    @@media (max-width: 768px) {
        .profile-avatar {
            left: 50%;
            transform: translateX(-50%);
            top: 14px;
            width: 96px;
            height: 96px;
            font-size: 32px;
            border-width: 5px;
        }

        .card-body {
            padding-top: 64px !important;
        }

        .d-flex.align-items-start {
            flex-direction: column;
            gap: 16px;
        }

        .profile-actions {
            width: 100%;
            align-items: stretch;
        }

        .profile-actions a {
            width: 100%;
        }

        .profile-info {
            text-align: center;
            max-width: 100%;
        }

        .profile-title {
            margin-left: 0;
            letter-spacing: 0.4px;
        }

        .meta-line {
            line-height: 1.5;
        }

        .desc-body {
            line-height: 1.6;
        }
    }
</style>