@model Vendor_FE.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Market</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="login-page">
        <div class="login-card shadow">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">Đăng nhập</h2>
                <p class="text-muted mb-0">Chào mừng trở lại Smart Market</p>
            </div>

            @if (!string.IsNullOrEmpty(Model?.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Identifier" class="form-label fw-semibold">Email hoặc Số điện thoại</label>
                    <input asp-for="Identifier" class="form-control form-control-lg" placeholder="you@example.com hoặc 0123456789" />
                    <span asp-validation-for="Identifier" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control form-control-lg" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Đăng nhập</button>
                </div>

                <div class="text-center">
                    <small>
                        Chưa có tài khoản?
                        <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                    </small>
                </div>
            </form>
        </div>
    </div>

    <style>
        body {
            margin: 0;
            background: linear-gradient(135deg, #f3f6fb, #e9eef8);
            font-family: Arial, sans-serif;
        }

        .login-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 20px;
            padding: 32px;
            border: none;
        }

        .form-control {
            border-radius: 12px;
        }

        .btn {
            border-radius: 12px;
            font-weight: 600;
        }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>