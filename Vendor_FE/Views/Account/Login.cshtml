@model Vendor_FE.Models.LoginViewModel

@{
    ViewData["Title"] = "Vendor Login";
}

<div class="d-flex justify-content-center align-items-center min-vh-75">
    <div class="card shadow-sm w-100" style="max-width:480px;">
        <div class="card-body p-4">
            <h3 class="card-title mb-3 text-center">Sign in to Vendor</h3>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }

            <form asp-action="Login" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label asp-for="Identifier" class="form-label">Email or Phone</label>
                    <input asp-for="Identifier" class="form-control form-control-lg" placeholder="you@example.com or 0123456789" />
                    <span asp-validation-for="Identifier" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control form-control-lg" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-2">
                    <button type="submit" class="btn btn-primary btn-lg">Login</button>
                </div>

                <div class="text-center">
                    <small>Don't have an account? <a asp-controller="Account" asp-action="Register">Register</a></small>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
