@model Vendor_FE.Models.EnterOtpViewModel

@{
    ViewData["Title"] = "Enter OTP";
}

<h2>Enter OTP</h2>

@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage as string))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form asp-action="EnterOtp" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Otp" class="form-label">OTP</label>
        <input asp-for="Otp" class="form-control" />
        <span asp-validation-for="Otp" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Verify OTP</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
