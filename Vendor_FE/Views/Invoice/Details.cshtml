@model Vendor_FE.DTOs.InvoiceDetailExportDTO
@{
    ViewData["Title"] = "Chi tiết Hóa đơn";
    var invoiceId = Model.InvoiceId; // Use Model id
}

<div class="container-fluid py-4 max-w-1000">
    <div class="d-flex align-items-center mb-4">
        <a href="/Invoice/Index" class="btn btn-light rounded-circle shadow-sm me-3" style="width: 40px; height: 40px; padding: 7px;">
            <i class="fa-solid fa-arrow-left text-muted"></i>
        </a>
        <h2 class="fw-bold mb-0 text-primary">
            <i class="fa-solid fa-receipt me-2"></i>Chi Tiết Hóa Đơn #@invoiceId
        </h2>
    </div>

    <!-- Hóa Đơn Card (Biên Lai) -->
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mt-4">
        <!-- Header Hóa Đơn -->
        <div class="bg-primary text-white p-4 p-md-5 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-1">SMART MARKET</h3>
                <p class="mb-0 text-white-50"><i class="fa-solid fa-location-dot me-1"></i>Hóa Đơn Dịch Vụ Hằng Tháng</p>
            </div>
            <div class="text-end">
                <h4 class="mb-1">INVOICE</h4>
                <p class="mb-0 fw-bold">#HD-@invoiceId</p>
            </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row mb-5">
                <div class="col-md-6">
                    <h5 class="text-muted fw-bold mb-3">Tới:</h5>
                    <div id="vendorInfo">
                        <h4 class="fw-bold text-dark" id="storeName">@(Model.BusinessName ?? "Không xác định")</h4>
                        <p class="mb-1 text-secondary" id="stallCode">Mã gian hàng: @(Model.StallCode ?? "N/A")</p>
                        <p class="mb-0 text-secondary" id="billingPeriod">Kỳ thu: Tháng @Model.Month/@Model.Year</p>
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-4 mt-md-0">
                    <h5 class="text-muted fw-bold mb-3">Trạng thái:</h5>
                    <div id="statusBadgeContainer">
                        @if (Model.Status == "PAID")
                        {
                            <span class="badge bg-success px-4 py-2 fs-6 rounded-pill shadow-sm mb-3">
                                <i class="fa-solid fa-check-circle me-1"></i> ĐÃ THANH TOÁN
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-4 py-2 fs-6 rounded-pill shadow-sm mb-3">
                                <i class="fa-solid fa-clock me-1"></i> CHƯA THANH TOÁN
                            </span>
                        }
                    </div>
                    <p class="mb-0 text-secondary" id="createdDate"><i class="fa-solid fa-calendar me-1"></i> Trích xuất lúc: @DateTime.Now.ToString("dd/MM/yyyy")</p>
                </div>
            </div>

            <!-- Bảng chi phí -->
            <div class="table-responsive rounded-3 border mb-5">
                <table class="table table-striped table-borderless align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="py-3 px-4">#</th>
                            <th class="py-3">Nội dung phí</th>
                            <th class="py-3 text-center">Số lượng</th>
                            <th class="py-3 text-end">Đơn giá</th>
                            <th class="py-3 px-4 text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceItemsTable">
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            var index = 1;
                            decimal subtotal = 0;
                            foreach (var item in Model.Items)
                            {
                                subtotal += item.Amount;
                                <tr>
                                    <td class="py-3 px-4 fw-bold">@index</td>
                                    <td class="py-3 text-dark">@item.FeeName</td>
                                    <td class="py-3 text-center">@(item.Quantity?.ToString("N0") ?? "-")</td>
                                    <td class="py-3 text-end">@(item.UnitPrice?.ToString("N0") + " đ" ?? "-")</td>
                                    <td class="py-3 px-4 text-end fw-bold">@item.Amount.ToString("N0") đ</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="py-3 text-center text-muted">Không có dữ liệu chi phí cho hóa đơn này.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row text-end border-top pt-4">
                <div class="col-md-7"></div>
                <div class="col-md-5 px-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng phụ:</span>
                        <span class="fw-bold">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                        <span class="text-muted">VAT (0%):</span>
                        <span class="fw-bold">0 đ</span>
                    </div>
                    <div class="d-flex justify-content-between bg-light p-3 rounded-3">
                        <span class="fw-bold text-primary fs-5">TỔNG CỘNG:</span>
                        <span class="fw-bold text-primary fs-4" id="totalAmount">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="card-footer bg-light p-4 d-flex justify-content-end gap-3">
            <a href="/Invoice/ExportPdf/@invoiceId" class="btn btn-outline-secondary px-4 rounded-pill hover-lift">
                <i class="fa-solid fa-file-pdf me-2"></i>Tải Xuống PDF
            </a>
            <button class="btn btn-success px-4 rounded-pill hover-lift shadow">
                <i class="fa-solid fa-qrcode me-2"></i>Thanh Toán Ngay
            </button>
        </div>
    </div>
</div>

<style>
    .max-w-1000 { max-width: 1000px; margin: 0 auto; }
    .hover-lift { transition: transform 0.2s; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
</style>

