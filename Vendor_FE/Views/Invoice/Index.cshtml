@model List<Vendor_FE.DTOs.InvoiceResponseDTO>
@{
    ViewData["Title"] = "Hóa Đơn Dịch Vụ";
}

<div class="container-fluid py-4 max-w-1200">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            <strong>Lỗi thanh toán:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-primary">
            <i class="fa-solid fa-file-invoice-dollar me-2"></i>Hóa Đơn Dịch Vụ
        </h2>
    </div>

    <!-- Data Table -->
    <div class="card shadow border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="py-3 px-4 text-start">Mã HĐ</th>
                        <th class="py-3">Kỳ Thu Phí</th>
                        <th class="py-3 text-end">Tổng Tiền (VNĐ)</th>
                        <th class="py-3">Trạng Thái</th>
                        <th class="py-3 px-4 text-end">Hành Động</th>
                    </tr>
                </thead>
                <tbody id="invoiceTableBody">
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="5" class="py-4 text-center text-muted">Không có dữ liệu hóa đơn.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var isPaid = item.Status == "PAID";
                            var isPending = item.Status == "PENDING";
                            var dateDisplay = item.Month > 0 && item.Year > 0 ? $"{item.Month}/{item.Year}" : item.CreatedAt.ToString("MM/dd/yyyy");

                            <tr class="border-bottom">
                                <td class="py-3 px-4 fw-bold text-start">#HD-@item.InvoiceId.ToString("D6")</td>
                                <td class="py-3 text-muted">@dateDisplay</td>
                                <td class="py-3 fw-bold text-end @(isPaid ? "text-success" : (isPending ? "text-primary" : "text-danger"))">@item.TotalAmount.ToString("N0") đ</td>

                                @if (isPaid)
                                {
                                    <td class="py-3"><span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="fa-solid fa-check me-1"></i> Đã thanh toán</span></td>
                                }
                                else if (isPending)
                                {
                                    <td class="py-3"><span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm"><i class="fa-solid fa-spinner fa-spin me-1"></i> Chờ xác nhận</span></td>
                                }
                                else
                                {
                                    <td class="py-3"><span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm"><i class="fa-solid fa-clock me-1"></i> Chưa thanh toán</span></td>
                                }

                                <td class="py-3 px-4 text-end">
                                    <a href="/Invoice/Details/@item.InvoiceId" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2 hover-lift"><i class="fa-solid fa-eye me-1"></i>Chi tiết</a>

                                    @if (isPaid)
                                    {
                                        <a href="/Invoice/ExportPdf/@item.InvoiceId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 hover-lift"><i class="fa-solid fa-file-pdf me-1"></i>Tải PDF</a>
                                    }
                                    else if (!isPending)
                                    {
                                        <a href="/Invoice/PayWithMomo/@item.InvoiceId"
                                           class="btn btn-sm rounded-pill px-3 hover-lift"
                                           style="background:#a50064;color:#fff;">
                                            Thanh toán MoMo
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



<style>
    .max-w-1200 { max-width: 1200px; margin: 0 auto; }
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .hover-lift { transition: transform 0.2s; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        if (params.get('paid') === '1') {
            Swal.fire({
                icon: 'success',
                title: 'Thanh toán thành công!',
                text: 'Vui lòng chờ nhân viên xác nhận.',
                confirmButtonColor: '#a50064',
                confirmButtonText: 'OK'
            });
            history.replaceState(null, '', window.location.pathname);
        } else if (params.get('paid') === '0') {
            const msg = params.get('msg') || 'Giao dịch bị huỷ.';
            Swal.fire({ icon: 'error', title: 'Thất bại', text: msg, confirmButtonColor: '#dc3545' });
            history.replaceState(null, '', window.location.pathname);
        }
    </script>
}
