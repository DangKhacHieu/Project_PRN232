@{
    ViewData["Title"] = "Xem sơ đồ chợ";
    <link rel="stylesheet" href="~/css/market-map-view.css" />
}

<div class="row">
    <div class="col-md-3">
        <div class="card shadow-sm border-info">
            <div class="card-body">
                <h4 class="card-title text-info mb-3">🔍 Chọn sơ đồ</h4>

                <div class="form-group mb-3">
                    <label class="fw-bold mb-2">Chọn chợ cần xem:</label>
                    <select id="viewMarketId" class="form-select form-select-lg">
                        <option value="">-- Đang tải danh sách chợ --</option>
                    </select>
                </div>

                <button class="btn btn-info w-100 mb-3 fw-bold fs-5 text-white shadow-sm" id="btnLoadViewMap">
                    Tải sơ đồ lên
                </button>

                <hr />
                <button class="btn btn-warning w-100 fw-bold shadow" id="btnGoToEdit" style="display: none;">
                    ⚙️ Chuyển sang Cập nhật sơ đồ
                </button>
            </div>
        </div>

        <div class="card shadow-sm mt-3 border-primary" id="searchCard" style="display: none;">
            <div class="card-body py-3">
                <h5 class="fw-bold text-primary mb-3"><i class="bi bi-search"></i> Tra cứu Sạp</h5>

                <label class="fw-bold mb-1 small text-muted">Từ khóa (Mã, Tên chủ, Mặt hàng...):</label>
                <input type="text" id="txtSearchStall" class="form-control mb-3 border-primary" placeholder="Nhập từ khóa...">

                <label class="fw-bold mb-1 small text-muted">Trạng thái:</label>
                <select id="selStatus" class="form-select mb-4 border-primary">
                    <option value="">-- Mọi trạng thái --</option>
                    <option value="VACANT">🟢 Còn trống</option>
                    <option value="RENTED">🔴 Đã cho thuê</option>
                    <option value="MAINTENANCE">🟡 Đang bảo trì</option>
                </select>

                <div class="d-flex gap-2">
                    <button id="btnSearch" class="btn btn-primary w-100 fw-bold">🔍 Tìm kiếm</button>
                    <button id="btnResetSearch" class="btn btn-outline-secondary w-100 fw-bold">Hủy</button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3 border-secondary" id="legendCard" style="display: none;">
            <div class="card-body py-2">
                <h6 class="fw-bold text-secondary mb-2">Chú thích:</h6>
                <div class="d-flex align-items-center mb-1"><div style="width: 15px; height: 15px; background: #28a745; margin-right: 10px; border-radius: 3px;"></div> Đang trống</div>
                <div class="d-flex align-items-center mb-1"><div style="width: 15px; height: 15px; background: #dc3545; margin-right: 10px; border-radius: 3px;"></div> Đã cho thuê</div>
                <div class="d-flex align-items-center"><div style="width: 15px; height: 15px; background: #ffc107; margin-right: 10px; border-radius: 3px;"></div> Đang bảo trì</div>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <h3 id="displayMarketName" class="text-center text-primary mb-3 text-uppercase fw-bold"></h3>
        <div id="mapContainer" style="position: relative; width: 100%; height: 750px; background-color: #f8f9fa; border: 2px solid #ccc; overflow: auto; border-radius: 8px; box-shadow: inset 0 0 10px rgba(0,0,0,0.05);">
            <p class="text-center text-muted mt-5 fs-5" id="mapPlaceholder">Vui lòng chọn Tên chợ ở menu bên trái để hiển thị sơ đồ</p>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- New: externalized view JS -->
<script src="~/js/market-map-view.js"></script>
