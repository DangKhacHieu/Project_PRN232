@{
    // Khai báo sử dụng Layout chung của Admin (nếu có)
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách Tiểu thương";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Danh sách Tiểu thương</h3>
        <div>
            <button id="btnRefresh" class="btn btn-sm btn-outline-secondary">Làm mới</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-3">
            <div class="mb-3 row">
                <div class="col-md-4">
                    <input id="txtSearch" class="form-control" placeholder="🔍 Tìm theo mã / tên / email..." />
                </div>
            </div>

            <div class="table-responsive">
                <table id="vendorsTable" class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Tên doanh nghiệp</th>
                            <th>Người liên hệ</th>
                            <th>Email / SĐT</th>
                            <th>Ngày tạo</th>
                            <th style="width: 140px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div id="vendorsEmpty" class="text-center text-muted mt-4 mb-4" style="display:none;">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">Không có tiểu thương nào trong hệ thống.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Check lại Port API của bạn nhé
        const API_BASE = 'https://localhost:7169/api';

        $(document).ready(function () {
            const $tableBody = $('#vendorsTable tbody');
            const $empty = $('#vendorsEmpty');

            function renderRow(v) {
                const created = v.createdAt ? new Date(v.createdAt).toLocaleString('vi-VN') : '';
                const contact = (v.user && (v.user.email || v.user.phone)) ? `${v.user.email || ''} <br/> ${v.user.phone || ''}` : (v.contact || '');
                return `
                <tr data-id="${v.vendorId}">
                    <td class="text-center fw-bold">${v.vendorId}</td>
                    <td class="text-primary fw-bold">${escapeHtml(v.businessName || '')}</td>
                    <td>${escapeHtml(v.user?.fullName || v.contactName || '')}</td>
                    <td>${contact}</td>
                    <td>${created}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-primary btn-view">Xem</button>
                        <button class="btn btn-sm btn-danger btn-delete">Xóa</button>
                    </td>
                </tr>
                `;
            }

            function loadVendors() {
                $tableBody.empty();
                $empty.hide();
                $('#btnRefresh').prop('disabled', true).text('Đang tải...');

                $.ajax({
                    url: `${API_BASE}/vendors`,
                    type: 'GET',
                    cache: false,
                    success: function (res) {
                        $('#btnRefresh').prop('disabled', false).text('Làm mới');

                        if (!res || !res.length) {
                            $empty.show();
                            return;
                        }

                        res.forEach(v => {
                            $tableBody.append(renderRow(v));
                        });
                    },
                    error: function (xhr) {
                        $('#btnRefresh').prop('disabled', false).text('Làm mới');
                        console.error('Load vendors error', xhr);
                        $empty.html('<span class="text-danger">Không thể kết nối đến máy chủ API. Vui lòng kiểm tra lại.</span>').show();
                    }
                });
            }

            // Client-side Search
            $('#txtSearch').on('input', function () {
                const q = $(this).val().toLowerCase();
                $('#vendorsTable tbody tr').each(function () {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(q) !== -1);
                });
            });

            $('#btnRefresh').click(loadVendors);

            $('#vendorsTable').on('click', '.btn-view', function () {
                const id = $(this).closest('tr').data('id');
                window.location.href = `/Vendors/Details?id=${id}`;
            });

            // 👉 Đã fix lỗi Syntax JS ở đây
            $('#vendorsTable').on('click', '.btn-delete', function () {
                const $tr = $(this).closest('tr');
                const id = $tr.data('id');
                if (!id) return;

                Swal.fire({
                    title: 'Xóa tiểu thương?',
                    text: 'Hành động này sẽ xóa toàn bộ hồ sơ. Không thể hoàn tác.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa ngay',
                    confirmButtonColor: '#dc3545'
                }).then((r) => {
                    if (!r.isConfirmed) return;

                    $.ajax({
                        url: `${API_BASE}/vendors/${id}`,
                        type: 'DELETE',
                        success: function () {
                            $tr.fadeOut(300, function () { $(this).remove(); });
                            if ($('#vendorsTable tbody tr').length <= 1) $empty.show();
                            Swal.fire('Đã xóa', 'Hồ sơ đã được gỡ khỏi hệ thống.', 'success');
                        },
                        error: function (xhr) {
                            const msg = xhr.responseJSON?.message || xhr.responseText || 'Không thể xóa.';
                            Swal.fire('Lỗi', msg, 'error');
                        }
                    });
                });
            });

            function escapeHtml(s) {
                if (!s) return '';
                return String(s)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');
            }

            // Gọi API lần đầu
            loadVendors();
        });
    </script>
}