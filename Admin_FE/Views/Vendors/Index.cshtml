@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách Tiểu thương";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Danh sách Tiểu thương</h3>
        <div>
            <button id="btnRefresh" class="btn btn-sm btn-outline-secondary">Làm mới</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-3">
            <div class="mb-3 row">
                <div class="col-md-4">
                    <input id="txtSearch" class="form-control" placeholder="🔍 Tìm theo mã / tên / email..." />
                </div>
            </div>

            <div class="table-responsive">
                <table id="vendorsTable" class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Tên doanh nghiệp</th>
                            <th>Người liên hệ</th>
                            <th>Email / SĐT</th>
                            <th>Ngày tạo</th>
                            <th style="width: 220px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div id="vendorsEmpty" class="text-center text-muted mt-4 mb-4" style="display:none;">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">Không có tiểu thương nào trong hệ thống.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const API_BASE = 'https://localhost:7169/api';

        $(document).ready(function () {
            const $tableBody = $('#vendorsTable tbody');
            const $empty = $('#vendorsEmpty');

            function renderRow(v) {
                const created = v.createdAt ? new Date(v.createdAt).toLocaleString('vi-VN') : '';
                const contact = (v.user && (v.user.email || v.user.phone))
                    ? `${escapeHtml(v.user.email || '')} <br/> ${escapeHtml(v.user.phone || '')}`
                    : '';

                return `
                <tr data-id="${v.vendorId}">
                    <td class="text-center fw-bold">${v.vendorId}</td>
                    <td class="text-primary fw-bold">${escapeHtml(v.businessName || '')}</td>
                    <td>${escapeHtml(v.user?.fullName || '')}</td>
                    <td>${contact}</td>
                    <td>${created}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-warning btn-reset-password">Cập nhật mật khẩu</button>
                        <button class="btn btn-sm btn-danger btn-delete">Xóa</button>
                    </td>
                </tr>
                `;
            }

            function loadVendors() {
                $tableBody.empty();
                $empty.hide();
                $('#btnRefresh').prop('disabled', true).text('Đang tải...');

                $.ajax({
                    url: `${API_BASE}/vendors`,
                    type: 'GET',
                    cache: false,
                    success: function (res) {
                        $('#btnRefresh').prop('disabled', false).text('Làm mới');

                        if (!res || !res.length) {
                            $empty.show();
                            return;
                        }

                        res.forEach(v => $tableBody.append(renderRow(v)));
                    },
                    error: function (xhr) {
                        $('#btnRefresh').prop('disabled', false).text('Làm mới');
                        console.error('Load vendors error', xhr);
                        $empty.html('<span class="text-danger">Không thể kết nối đến máy chủ API. Vui lòng kiểm tra lại.</span>').show();
                    }
                });
            }

            $('#txtSearch').on('input', function () {
                const q = $(this).val().toLowerCase();
                $('#vendorsTable tbody tr').each(function () {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(q) !== -1);
                });
            });

            $('#btnRefresh').click(loadVendors);

            $('#vendorsTable').on('click', '.btn-reset-password', function () {
                const vendorId = $(this).closest('tr').data('id');
                if (!vendorId) return;

                $.ajax({
                    url: `${API_BASE}/vendors/${vendorId}/reset-password-preview`,
                    type: 'POST',
                    success: function (res) {
                        Swal.fire({
                            title: 'Mật khẩu mới đã được random',
                            html: `
                                <div class="text-start">
                                    <p class="mb-2"><strong>Tiểu thương:</strong> ${escapeHtml(res.businessName || '')}</p>
                                    <p class="mb-2"><strong>Người liên hệ:</strong> ${escapeHtml(res.contactName || '')}</p>
                                    <p class="mb-3"><strong>Email:</strong> ${escapeHtml(res.email || '')}</p>
                                    <div class="alert alert-warning mb-0">
                                        <div class="fw-bold mb-2">Mật khẩu mới:</div>
                                        <div style="font-size: 1.2rem; word-break: break-all;">${escapeHtml(res.newPassword || '')}</div>
                                    </div>
                                    <p class="text-muted mt-3 mb-0">Bấm <strong>Xác nhận</strong> để lưu mật khẩu này vào hệ thống.</p>
                                </div>
                            `,
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonText: 'Xác nhận',
                            cancelButtonText: 'Hủy',
                            width: 650,
                            preConfirm: () => {
                                return $.ajax({
                                    url: `${API_BASE}/vendors/${vendorId}/confirm-reset-password`,
                                    type: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify({ newPassword: res.newPassword })
                                }).then(response => response).catch(xhr => {
                                    const msg = xhr.responseJSON?.message || 'Không thể cập nhật mật khẩu.';
                                    Swal.showValidationMessage(msg);
                                });
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                Swal.fire('Thành công', 'Mật khẩu mới đã được lưu. Admin có thể tự gửi lại cho tiểu thương.', 'success');
                            }
                        });
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || 'Không thể tạo mật khẩu mới.';
                        Swal.fire('Lỗi', msg, 'error');
                    }
                });
            });

            $('#vendorsTable').on('click', '.btn-delete', function () {
                const $tr = $(this).closest('tr');
                const id = $tr.data('id');
                if (!id) return;

                Swal.fire({
                    title: 'Xóa tiểu thương?',
                    text: 'Hành động này sẽ xóa toàn bộ hồ sơ. Không thể hoàn tác.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa ngay',
                    confirmButtonColor: '#dc3545'
                }).then((r) => {
                    if (!r.isConfirmed) return;

                    $.ajax({
                        url: `${API_BASE}/vendors/${id}`,
                        type: 'DELETE',
                        success: function () {
                            $tr.fadeOut(300, function () { $(this).remove(); });
                            if ($('#vendorsTable tbody tr').length <= 1) $empty.show();
                            Swal.fire('Đã xóa', 'Hồ sơ đã được gỡ khỏi hệ thống.', 'success');
                        },
                        error: function (xhr) {
                            const msg = xhr.responseJSON?.message || xhr.responseText || 'Không thể xóa.';
                            Swal.fire('Lỗi', msg, 'error');
                        }
                    });
                });
            });

            function escapeHtml(s) {
                if (!s) return '';
                return String(s)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');
            }

            loadVendors();
        });
    </script>
}
