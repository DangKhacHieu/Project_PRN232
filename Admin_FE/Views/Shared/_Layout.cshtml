@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, string> isActive = (c, a) =>
    {
        if (!string.IsNullOrEmpty(c) && c.Equals(currentController, StringComparison.OrdinalIgnoreCase))
            return "active";
        return "";
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>

    <!-- Bootstrap (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Sidebar styles (inline so layout is self-contained) */
        .admin-layout { min-height: 100vh; display: flex; }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: #ffffff;
            border-right: 1px solid #e5e7eb;
            padding-top: 0.5rem;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }
        .admin-sidebar .sidebar-header { padding: 1rem; border-bottom: 1px solid #f1f5f9; }
        .admin-sidebar .nav-link {
            color: #374151;
            padding: 0.65rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            border-radius: 6px;
        }
        .admin-sidebar .nav-link.active,
        .admin-sidebar .nav-link:hover {
            background: #f1f5f9;
            color: #000;
            text-decoration: none;
        }
        .admin-sidebar .sidebar-footer { padding: 1rem; font-size: .85rem; color: #6b7280; border-top: 1px solid #f1f5f9; }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                position: fixed;
                z-index: 1045;
                left: -260px;
                top: 0;
                transition: left .22s ease-in-out;
            }
            .admin-sidebar.show {
                left: 0;
            }
            .content-area { margin-left: 0; }
            .backdrop-mobile {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.35);
                z-index: 1040;
            }
            .backdrop-mobile.show { display: block; }
        }

        /* Main area */
        .content-area { flex: 1; padding: 1rem; }
        .topbar { background: #fff; border-bottom: 1px solid #e5e7eb; padding: .5rem 1rem; }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <nav id="adminSidebar" class="admin-sidebar shadow-sm">
            <div class="sidebar-header d-flex align-items-center justify-content-between">
                <div>
                    <strong class="d-block">Admin</strong>
                    <small class="text-muted">Quản trị hệ thống</small>
                </div>
                <button id="btnCloseSidebar" class="btn btn-sm btn-light d-lg-none" aria-label="Close sidebar">✕</button>
            </div>

            <ul class="nav flex-column p-2">
                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("MarketMap", "Create")" href="@Url.Action("Create", "MarketMap")">
                        <span>🏗️</span> <span>Tạo chợ</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("MarketMap", "Index")" href="@Url.Action("Index", "MarketMap")">
                        <span>🗺️</span> <span>Xem bản đồ chợ</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Vendors", "Index")" href="@Url.Action("Index", "Vendors")">
                        <span>🧑‍🤝‍🧑</span> <span>Danh sách tiểu thương</span>
                    </a>
                </li>
                <li class="nav-item mt-3 mb-1">
                    <small class="text-muted px-3 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Nghiệp vụ thuê sạp</small>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Contracts", "Index")" href="@Url.Action("Index", "Contracts")">
                        <span>📄</span> <span>Danh sách hợp đồng</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Contracts", "Create")" href="@Url.Action("Create", "Contracts")">
                        <span>➕</span> <span>Tạo hợp đồng mới</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Contracts", "History")" href="@Url.Action("History", "Contracts")">
                        <span>📜</span> <span>Lịch sử biến động</span>
                    </a>
                </li>
                <li class="nav-item mt-3 mb-1">
                    <small class="text-muted px-3 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Hỗ trợ tiểu thương</small>
                </li>

                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Tickets", "Index")" href="@Url.Action("Index", "Tickets")">
                        <span>🛠️</span> <span>Danh sách sự cố</span>
                        @* Bạn có thể thêm badge hiển thị số lượng sự cố mới ở đây nếu muốn *@
                    </a>
                </li>

                <!-- Finance links -->
                <li class="nav-item mb-1 mt-3">
                    <div class="text-uppercase text-muted" style="font-size: 0.75rem; padding-left: 1rem; margin-bottom: 0.5rem; font-weight: 600;">Tài chính</div>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Finance", "Utilities")" href="@Url.Action("Utilities", "Finance")">
                        <span>⚡</span> <span>Chỉ số Điện / Nước</span>
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link @isActive("Finance", "Invoices")" href="@Url.Action("Invoices", "Finance")">
                        <span>🧾</span> <span>Quản lý Hóa Đơn</span>
                    </a>
                </li>

                <!-- Add more admin links here -->
            </ul>

            <div class="sidebar-footer">
                <div>Phiên bản: 1.0</div>
                <div class="mt-1">Xin chào, <strong>@User?.Identity?.Name</strong></div>
            </div>
        </nav>

        <!-- mobile backdrop -->
        <div id="mobileBackdrop" class="backdrop-mobile"></div>

        <!-- Main content -->
        <div class="content-area">
            <header class="topbar d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <button id="btnToggleSidebar" class="btn btn-outline-secondary btn-sm me-2 d-lg-none" aria-label="Open sidebar">☰</button>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <!-- top actions: user, settings... -->
                    <div class="text-muted small">Chế độ: <span class="badge bg-warning text-dark">Chỉnh sửa trực tiếp</span></div>
                </div>
            </header>

            <main role="main" class="mt-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const sidebar = document.getElementById('adminSidebar');
            const btnToggle = document.getElementById('btnToggleSidebar');
            const btnClose = document.getElementById('btnCloseSidebar');
            const backdrop = document.getElementById('mobileBackdrop');

            function openSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
            }
            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            if (btnToggle) btnToggle.addEventListener('click', openSidebar);
            if (btnClose) btnClose.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            // Close sidebar on ESC
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // highlight active link client-side as well (in case route names differ)
            (function highlight() {
                try {
                    const links = document.querySelectorAll('.admin-sidebar .nav-link');
                    const currentPath = window.location.pathname.toLowerCase();
                    links.forEach(a => {
                        const href = a.getAttribute('href') || '';
                        if (href && currentPath.startsWith(href.toLowerCase())) a.classList.add('active');
                    });
                } catch (ex) { /* ignore */ }
            })();
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
